# Optional env for lnc-styles-gallery Rust stack (v1.0.0.0).
# Copy to infra/.env on the deploy host (next to docker-compose.yml).

# Enforce Bearer-token gate on /mcp (keys stored as salted HMAC-SHA256 in /config/keys.json)
STYLES_MCP_AUTH=1

# 32-byte master key (64 hex chars or base64); auto-generated into /config/.master.key (0600) in dev if unset
# LNC_MASTER_KEY=

# Break-glass management key (hashed at rest with Argon2id; never stored in plaintext)
# MANAGEMENT_KEY=

# Keycloak OIDC SSO (lengoc realm, PKCE S256)
# OIDC_ISSUER_URL=https://auth.lengoc.me/realms/lengoc
# OIDC_CLIENT_ID=lnc-styles-gallery
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://styles.lengoc.me/api/auth/oidc/callback
# OIDC_ALLOWED_USERS=
# OIDC_ALLOWED_GROUPS=/admins
